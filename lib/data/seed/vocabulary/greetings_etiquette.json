    "somali": {
      "translation": "salaan",
      "alternative_translations": [],
      "explanation": "Erey ama hadal lagu salaamo qof marka la kulmayo ama la kala tagayo."
    },
    "part_of_speech": "noun",
    "cefr": "A1",
    "senses": [
      {
        "definition": "A word or phrase used to welcome or acknowledge someone.",
        "translation": "salaan",
        "examples": [
          {
            "english": "She greeted us with a warm smile.",
            "somali": "Waxay nagu salaantay dhoolla-caddayn diiran."
          },
          {
            "english": "A polite greeting makes a good first impression.",
            "somali": "Salaan edeb leh waxay reebtaa aragti wanaagsan."
          }
        ]
      }
    ],
    "collocations": [
      {
